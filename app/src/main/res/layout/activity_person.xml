<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_person"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/on_surface"
        app:title=""
        app:titleTextColor="@color/on_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="128dp"
            android:layout_height="128dp"
            app:cardBackgroundColor="@color/surface_container_high"
            app:cardCornerRadius="64dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/img_person_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="30dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                app:tint="@color/on_surface_variant" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_person_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:fontFamily="?attr/appFontBold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.0"
            android:maxLines="2"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_person_role"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/badge_background"
            android:fontFamily="?attr/appFontMedium"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textColor="@color/primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_person_works_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="?attr/appFontRegular"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="?attr/appFontBold"
        android:text="@string/s_25912e8"
        android:textColor="@color/on_surface"
        android:textSize="17sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_person_works"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingBottom="24dp" />

        <!-- 4 skeleton cards, 2 columns, so the header never jumps while loading -->
        <GridLayout
            android:id="@+id/skeleton_person"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:columnCount="2"
            android:visibility="gone">

            <View
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_skeleton" />
        </GridLayout>

        <LinearLayout
            android:id="@+id/layout_person_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="36dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:alpha="0.5"
                android:src="@drawable/ic_movie_placeholder"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="?attr/appFontBold"
                android:gravity="center"
                android:text="@string/person_empty_title"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="?attr/appFontRegular"
                android:gravity="center"
                android:text="@string/person_empty_desc"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_person_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="36dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:alpha="0.6"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="?attr/appFontBold"
                android:gravity="center"
                android:text="@string/person_error_title"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_person_retry"
                style="@style/Widget.Bisnor.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:fontFamily="?attr/appFontMedium"
                android:text="@string/person_retry"
                android:textSize="13sp"
                app:cornerRadius="100dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
