<Window x:Class="BisnorDesktop.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پخش بیسنور"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Black"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="Root" Background="Black">
        <MediaElement x:Name="Media"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      ScrubbingEnabled="True"
                      Stretch="Uniform"
                      MediaEnded="Media_MediaEnded"
                      MediaFailed="Media_MediaFailed"
                      MediaOpened="Media_MediaOpened" />

        <Border x:Name="TitleBar"
                VerticalAlignment="Top"
                Background="#B3000000"
                Padding="22,14"
                Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="TitleText"
                           Foreground="White"
                           FontFamily="Vazirmatn, Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,60,0"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="CloseButton"
                        Content="✕"
                        HorizontalAlignment="Right"
                        Width="42" Height="34"
                        Background="#33FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="15"
                        Cursor="Hand"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <Border x:Name="ControlBar"
                VerticalAlignment="Bottom"
                Background="#CC000000"
                Padding="22,10,22,16"
                Visibility="Collapsed">
            <StackPanel>
                <Slider x:Name="SeekBar"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        IsMoveToPointEnabled="True"
                        Thumb.DragStarted="SeekBar_DragStarted"
                        Thumb.DragCompleted="SeekBar_DragCompleted"
                        ValueChanged="SeekBar_ValueChanged" />
                <Grid Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="PlayPauseButton" Content="❚❚" Click="PlayPauseButton_Click"
                                Width="44" Height="36" Background="#26FFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="14" Cursor="Hand" />
                        <Button Content="−۱۰" Click="RewindButton_Click" Margin="6,0,0,0"
                                Width="52" Height="36" Background="#1AFFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="12" Cursor="Hand" />
                        <Button Content="+۱۰" Click="ForwardButton_Click" Margin="6,0,0,0"
                                Width="52" Height="36" Background="#1AFFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="12" Cursor="Hand" />
                        <TextBlock x:Name="TimeText" Foreground="#DDDDDD" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MuteButton" Content="🔊" Click="MuteButton_Click"
                                Width="42" Height="36" Background="#1AFFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="14" Cursor="Hand" />
                        <Slider x:Name="VolumeBar" Width="110" Minimum="0" Maximum="1" Value="0.9"
                                VerticalAlignment="Center" Margin="8,0,10,0"
                                ValueChanged="VolumeBar_ValueChanged" />
                        <Button Content="⤢" Click="FullscreenButton_Click"
                                Width="42" Height="36" Background="#1AFFFFFF" Foreground="White"
                                BorderThickness="0" FontSize="15" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="ErrorOverlay" Background="#E6000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <TextBlock Text="پخش داخلی این فایل ممکن نشد"
                           Foreground="White" FontFamily="Vazirmatn, Segoe UI" FontSize="22"
                           FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText"
                           Foreground="#CFCFCF" FontFamily="Vazirmatn, Segoe UI" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,22" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="پخش با پلیر خارجی" Click="OpenExternal_Click"
                            Padding="18,10" Background="#FF6B6B" Foreground="White"
                            BorderThickness="0" Cursor="Hand" />
                    <Button Content="بستن" Click="CloseButton_Click" Margin="10,0,0,0"
                            Padding="18,10" Background="#2A2A2A" Foreground="White"
                            BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
