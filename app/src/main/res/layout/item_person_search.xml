<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardBackgroundColor="@color/surface_container_high"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline_variant"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/img_people_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="17dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:tint="@color/on_surface_variant" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_people_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="?attr/appFontMedium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.0"
        android:maxLines="2"
        android:textColor="@color/on_surface"
        android:textSize="11.5sp" />
</LinearLayout>
