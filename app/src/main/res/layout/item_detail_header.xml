<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ================= Immersive artwork ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="430dp">

        <ImageView
            android:id="@+id/img_header_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_detail_header_gradient" />

        <View
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/scrim_top_gradient" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingBottom="18dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="112dp"
                android:layout_height="160dp"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/img_header_poster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:maxLines="3"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="@color/white"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/tv_header_original_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:maxLines="1"
                    android:textColor="#CCF8F5F1"
                    android:textSize="11.5sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_header_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_soft_pill"
                        android:drawableStart="@drawable/ic_star"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/rating_gold"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_header_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_soft_pill"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_header_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_soft_pill"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_header_age_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_background"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:textColor="@color/tertiary"
                        android:textSize="10.5sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_header_genres"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:maxLines="1"
                        android:textColor="#CCF8F5F1"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ================= Primary actions ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_header_play"
            style="@style/Widget.Bisnor.Button"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/btn_watch_now"
            app:icon="@drawable/ic_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_header_add_playlist"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="9dp"
            android:backgroundTint="@color/surface_container_high"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_bookmark"
            app:iconTint="@color/on_surface"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_header_share_chat"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="9dp"
            android:backgroundTint="@color/surface_container_high"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_share"
            app:iconTint="@color/on_surface"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_header_trailer"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="9dp"
            android:backgroundTint="@color/surface_container_high"
            android:visibility="gone"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_videoplayer"
            app:iconTint="@color/on_surface"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- ================= API metadata badges ================= -->
    <HorizontalScrollView
        android:id="@+id/scroll_header_badges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="18dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/linear_header_badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- ================= Synopsis ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_surface"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_bold"
            android:text="@string/label_storyline"
            android:textColor="@color/on_surface"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tv_header_storyline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_regular"
            android:lineSpacingExtra="4dp"
            android:maxLines="4"
            android:textColor="@color/on_surface_variant"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btn_expand_story"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/vazirmatn_medium"
            android:paddingVertical="4dp"
            android:text="بیشتر"
            android:textColor="@color/primary"
            android:textSize="11.5sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ================= Cast & crew ================= -->
    <LinearLayout
        android:id="@+id/layout_header_people"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:text="بازیگران و عوامل"
            android:textColor="@color/on_surface"
            android:textSize="15.5sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_header_people"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- ================= Seasons & episodes ================= -->
    <TextView
        android:id="@+id/tv_header_section_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="@string/label_select_quality"
        android:textColor="@color/on_surface"
        android:textSize="15.5sp" />

    <HorizontalScrollView
        android:id="@+id/scroll_seasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingHorizontal="18dp"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_seasons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true" />
    </HorizontalScrollView>
</LinearLayout>
