<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_review_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="ثبت نظر و امتیاز شما"
        android:textColor="@color/on_surface"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/tv_review_movie_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/vazirmatn_regular"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn_medium"
            android:text="نمره و امتیاز شما:"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_review_rating_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_background"
            android:fontFamily="@font/vazirmatn_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="⭐ 8.0 / 10"
            android:textColor="@color/primary"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_user_rating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:stepSize="0.5"
        android:value="8.0"
        android:valueFrom="1.0"
        android:valueTo="10.0" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="یادداشت یا نظر شما درباره این اثر...">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_review_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_regular"
            android:gravity="top"
            android:lines="3"
            android:maxLines="5" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_review"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="انصراف" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_review"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="ثبت نظر و نمره"
            app:backgroundTint="@color/primary" />
    </LinearLayout>
</LinearLayout>
