<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_capsule_progress"
        android:alpha="0.5" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="انتخاب تصویر پروفایل اختصاصی 🎭"
        android:textColor="@color/on_surface"
        android:textSize="17sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/vazirmatn_regular"
        android:text="کاراکتر مورد علاقه خود را انتخاب کنید و پیش‌نمایش آن را ببینید:"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <!-- Live Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/surface_container_high"
        app:cardCornerRadius="20dp"
        app:strokeColor="@color/outline_variant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_selected_halo" />

                <ImageView
                    android:id="@+id/img_avatar_live_preview"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:contentDescription="Live Preview"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_avatar_preview_character"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/vazirmatn_bold"
                android:textColor="@color/primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_avatar_preview_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn_regular"
                android:text="پیش‌نمایش تصویر روی حساب کاربری شما"
                android:textColor="@color/on_surface_variant"
                android:textSize="11.5sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Avatars Grid RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_avatars_selection"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:clipToPadding="false"
        android:paddingVertical="4dp"
        android:scrollbars="vertical" />

    <!-- Confirm Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_avatar"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="تأیید و ذخیره آواتار ✨"
        android:textSize="14sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="14dp" />

</LinearLayout>
