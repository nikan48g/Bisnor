<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="110dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_bold"
            android:text="تنظیمات"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/vazirmatn_regular"
            android:text="پخش، ظاهر و دانلودها"
            android:textColor="@color/on_surface_variant"
            android:textSize="12.5sp" />

        <!-- Downloads -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="دانلودها و ذخیره‌سازی"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_setting_downloads"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:text="مدیریت دانلودها"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="فایل‌های ذخیره‌شده و تماشای آفلاین"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Watchlist transfer -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="واچ‌لیست"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_setting_import"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="وارد کردن واچ‌لیست"
                    android:src="@drawable/ic_import_list"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:text="وارد کردن واچ‌لیست"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="لینک یا کد دریافتی از دوستان"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Social links (social.md) -->
        <LinearLayout
            android:id="@+id/settings_social_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.Bisnor.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:text="ما را در اینترنت دنبال کنید"
                android:textColor="@color/primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:text="در اینترنت مارو دنبال کن!"
                    android:textColor="@color/on_surface"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:text="خبرهای بیسنور و لینک‌های رسمی ما در این شبکه‌ها منتشر می‌شود."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:id="@+id/social_links_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Appearance -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="ظاهر برنامه"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_medium"
                android:text="پوسته برنامه"
                android:textColor="@color/on_surface"
                android:textSize="13.5sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_themes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_system"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="سیستم" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_dark"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تاریک" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_light"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="روشن" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Content sources -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="منابع محتوا"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_medium"
                android:text="منبع پخش"
                android:textColor="@color/on_surface"
                android:textSize="13.5sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_sources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_source_next"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="نکست‌مووی" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_source_iranflix"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ایران‌فلیکس" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_source_both"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="هر دو" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="در حالت «هر دو»، هر عنوان یک‌بار نمایش داده می‌شود؛ اطلاعات از ایران‌فلیکس و قسمت‌ها و لینک‌ها از هر دو منبع می‌آید."
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Playback -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="پخش و ویدیو"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:text="پخش خودکار قسمت بعدی"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="نمایش تایمر و پخش خودکار قسمت بعد"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_setting_auto_next_time"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:text="زمان نمایش قسمت بعدی"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_auto_next_minutes_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:text="۲ دقیقه مانده به پایان"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_setting_player_choice"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:text="پخش‌کننده پیش‌فرض"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/tv_current_player_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="پلیر داخلی بیسنور"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:text="هشدار رده سنی"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="نمایش هشدار برای عناوین +۱۶ و +۱۸"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_content_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/vazirmatn_regular"
            android:gravity="center"
            android:text="بیسنور • تماشا بدون مرز"
            android:textColor="@color/outline"
            android:textSize="10.5sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
