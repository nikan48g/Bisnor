<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="کد و بارکد ارتباطی شما"
        android:textColor="@color/on_surface"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_qr_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/vazirmatn_medium"
        android:text="@username"
        android:textColor="@color/primary"
        android:textSize="15sp" />

    <!-- QR Code Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/img_qr_code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scaleType="fitCenter" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/vazirmatn_regular"
        android:text="دوستانتان با اسکن این کد یا وارد کردن نام کاربری شما می‌توانند به شما فیلم بفرستند."
        android:textAlignment="center"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_share_my_code"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="اشتراک‌گذاری لینک دوستی و چت 🔗"
        app:backgroundTint="@color/primary"
        app:cornerRadius="12dp" />

</LinearLayout>
