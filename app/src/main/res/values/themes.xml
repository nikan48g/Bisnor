<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Material 3 Theme (Light by default in values/) -->
    <style name="Theme.Bisnor" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface_container</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Bisnor.Headline</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Bisnor.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Bisnor.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Bisnor.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Bisnor.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Bisnor.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Bisnor.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Bisnor.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Bisnor.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Bisnor.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Bisnor.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Bisnor.Label</item>
    </style>

    <style name="TextAppearance.Bisnor.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
    </style>

    <style name="TextAppearance.Bisnor.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
    </style>

    <style name="TextAppearance.Bisnor.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
    </style>

    <style name="TextAppearance.Bisnor.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>

    <style name="TextAppearance.Bisnor.BottomNav" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TextAppearance.Bisnor.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="Theme.Bisnor.Light" parent="Theme.Bisnor" />

    <!-- Fullscreen Player Theme -->
    <style name="Theme.Bisnor.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
    </style>
</resources>
