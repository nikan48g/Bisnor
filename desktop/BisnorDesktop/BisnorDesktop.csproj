<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>wwwroot\assets\logo.ico</ApplicationIcon>
    <AssemblyName>Bisnor</AssemblyName>
    <RootNamespace>BisnorDesktop</RootNamespace>
    <Product>Bisnor</Product>
    <Company>HNN</Company>
    <Authors>HNN</Authors>
    <Description>Bisnor Cinema Desktop - Modern Iranian Media Streaming Client (Experimental)</Description>
    <Copyright>Copyright © 2026 HNN</Copyright>
    <Version>5.1.1.0</Version>
    <AssemblyVersion>5.1.1.0</AssemblyVersion>
    <FileVersion>5.1.1.0</FileVersion>
    <PackageId>HNN.Bisnor</PackageId>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
