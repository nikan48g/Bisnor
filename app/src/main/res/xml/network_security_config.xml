<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for video host domains and subdomains -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">dl175m.info</domain>
        <domain includeSubdomains="true">windowsdiba.info</domain>
        <domain includeSubdomains="true">hostinnegar.com</domain>
        <domain includeSubdomains="true">server-hi-speed-iran.info</domain>
    </domain-config>
</network-security-config>
