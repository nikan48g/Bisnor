<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="112dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="?attr/appFontBold"
                android:text="@string/s_476b3ee"
                android:textColor="@color/on_surface"
                android:textSize="32sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_settings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:backgroundTint="@color/surface_container_high"
                app:cornerRadius="100dp"
                app:icon="@drawable/ic_settings"
                app:iconSize="22dp"
                app:iconTint="@color/on_surface"
                app:strokeColor="@color/transparent"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Identity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp">

                <ImageView
                    android:id="@+id/img_profile_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_ring"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_account_circle" />

                <TextView
                    android:id="@+id/tv_profile_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="?attr/appFontBold"
                    android:gravity="center"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="?attr/appFontBold"
                    android:maxLines="1"
                    android:text="@string/s_b315663"
                    android:textColor="@color/on_surface"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_profile_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="?attr/appFontRegular"
                    android:maxLines="1"
                    android:text="@string/s_827f09c"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_action"
                style="@style/Widget.Bisnor.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:fontFamily="?attr/appFontBold"
                android:text="@string/s_32a81e5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tv_stat_movies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/appFontBold"
                    android:text="@string/s_9d13af3"
                    android:textColor="@color/primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="?attr/appFontRegular"
                    android:text="@string/s_b063120"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tv_stat_series"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/appFontBold"
                    android:text="@string/s_9d13af3"
                    android:textColor="@color/primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="?attr/appFontRegular"
                    android:text="@string/s_dee6fc4"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tv_stat_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/appFontBold"
                    android:text="@string/s_9d13af3"
                    android:textColor="@color/primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="?attr/appFontRegular"
                    android:text="@string/s_4321ff8"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Activity heatmap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="?attr/appFontBold"
                    android:text="@string/s_1323b9c"
                    android:textColor="@color/on_surface"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@+id/tv_heatmap_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/appFontRegular"
                    android:text="@string/s_e19266a"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/heatmap_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="118dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_heatmap_total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="?attr/appFontRegular"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="10.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/appFontRegular"
                    android:text="@string/s_38b171a"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="9.5sp" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@color/heat_1" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:background="@color/heat_2" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:background="@color/heat_3" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:background="@color/heat_4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/appFontRegular"
                    android:text="@string/s_81e4de6"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Continue watching -->
        <LinearLayout
            android:id="@+id/layout_profile_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/appFontBold"
                android:text="@string/s_f025339"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_profile_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <!-- Settings shortcuts -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="?attr/appFontBold"
            android:text="@string/s_781d50a"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_profile_account"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="?attr/appFontMedium"
                    android:text="@string/s_e97429f"
                    android:textColor="@color/on_surface"
                    android:textSize="13.5sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_profile_appearance"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tune"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="?attr/appFontMedium"
                    android:text="@string/s_ed79f5e"
                    android:textColor="@color/on_surface"
                    android:textSize="13.5sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_profile_servers"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_storage"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="?attr/appFontMedium"
                    android:text="@string/srv_row"
                    android:textColor="@color/on_surface"
                    android:textSize="13.5sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_profile_downloads"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="?attr/appFontMedium"
                    android:text="@string/s_9135e1e"
                    android:textColor="@color/on_surface"
                    android:textSize="13.5sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_profile_about"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_github"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="?attr/appFontMedium"
                    android:text="@string/s_97bbe8a"
                    android:textColor="@color/on_surface"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tv_profile_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/appFontRegular"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/divider_logout"
                style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_profile_logout"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/tertiary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="?attr/appFontMedium"
                    android:text="@string/s_e75c397"
                    android:textColor="@color/tertiary"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Follow us (social.md) — bottom of the profile tab -->
        <LinearLayout
            android:id="@+id/settings_social_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_surface"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/appFontBold"
                android:text="@string/s_6147de5"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="?attr/appFontRegular"
                android:gravity="center"
                android:text="@string/s_93b3a43"
                android:textColor="@color/on_surface_variant"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/social_links_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="?attr/appFontRegular"
            android:gravity="center"
            android:text="@string/s_ce0639b"
            android:textColor="@color/outline"
            android:textSize="10.5sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
