<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV style hero: full-bleed artwork, centred title, white play pill + glass buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/img_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_shade" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/tv_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="14"
            android:textColor="@color/white"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hero_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_medium"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tv_hero_genre_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_regular"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:textColor="#CCFFFFFF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tv_badge_rating"
                style="@style/TextAppearance.Bisnor.MetaChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="3dp"
                android:drawableTint="@color/rating_gold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hero_play"
                style="@style/Widget.Bisnor.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:minWidth="132dp"
                android:text="تماشا"
                app:icon="@drawable/ic_play" />

            <com.hnn.bisnor.ui.widget.GlassView
                android:id="@+id/btn_hero_save"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:contentDescription="افزودن به لیست"
                android:focusable="true"
                app:glassCornerRadius="24dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/white" />
            </com.hnn.bisnor.ui.widget.GlassView>

            <com.hnn.bisnor.ui.widget.GlassView
                android:id="@+id/btn_hero_details"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:contentDescription="اطلاعات"
                android:focusable="true"
                app:glassCornerRadius="24dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info"
                    app:tint="@color/white" />
            </com.hnn.bisnor.ui.widget.GlassView>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hero_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_regular"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/on_surface_variant"
            android:textSize="12.5sp" />
    </LinearLayout>
</FrameLayout>
