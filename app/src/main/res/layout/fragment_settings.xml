<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="110dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/appFontBold"
            android:text="@string/s_b67081a"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="?attr/appFontRegular"
            android:text="@string/s_029c280"
            android:textColor="@color/on_surface_variant"
            android:textSize="12.5sp" />

        <!-- Downloads -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/s_e4a3f47"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_setting_downloads"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/appFontMedium"
                        android:text="@string/s_7624e6e"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="?attr/appFontRegular"
                        android:text="@string/s_39778d4"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Watchlist transfer -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/s_39a97ef"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_setting_import"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/s_594a166"
                    android:src="@drawable/ic_import_list"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/appFontMedium"
                        android:text="@string/s_594a166"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="?attr/appFontRegular"
                        android:text="@string/s_a82105e"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Appearance -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/s_f42858f"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/appFontMedium"
                android:text="@string/s_5564d24"
                android:textColor="@color/on_surface"
                android:textSize="13.5sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_themes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_system"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/s_1ddbed6" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_dark"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s_8aa4968" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_theme_light"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s_fd5beab" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/appFontMedium"
                android:text="@string/settings_language"
                android:textColor="@color/on_surface"
                android:textSize="13.5sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_lang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lang_fa"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_fa" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lang_en"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_en" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/appFontMedium"
                android:text="@string/settings_ui_style"
                android:textColor="@color/on_surface"
                android:textSize="13.5sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_ui"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_ui_modern"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_modern_short" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_ui_classic"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_classic_short" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/appFontMedium"
                android:text="@string/settings_font"
                android:textColor="@color/on_surface"
                android:textSize="13.5sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_font"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_font_ajor"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/font_ajor" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_font_fancy"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/font_fancy" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Content sources -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/s_78ec594"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/appFontMedium"
                android:text="@string/s_1002cd0"
                android:textColor="@color/on_surface"
                android:textSize="13.5sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_sources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_source_next"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/s_1452e24" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_source_iranflix"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s_9a8fa14" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_source_both"
                    style="@style/Widget.Bisnor.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s_0eaf6cc" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/s_e12dcf3"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Playback -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/s_540bea8"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/appFontMedium"
                        android:text="@string/s_a476031"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="?attr/appFontRegular"
                        android:text="@string/s_ddf0c46"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    style="@style/Widget.Bisnor.Switch"
                    android:id="@+id/switch_auto_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_setting_auto_next_time"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="?attr/appFontMedium"
                    android:text="@string/s_f8013e0"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_auto_next_minutes_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/appFontBold"
                    android:text="@string/s_34205e4"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_setting_player_choice"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/appFontMedium"
                        android:text="@string/s_fc72396"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/tv_current_player_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="?attr/appFontRegular"
                        android:text="@string/s_4b35f47"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/appFontMedium"
                        android:text="@string/s_7d5e593"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="?attr/appFontRegular"
                        android:text="@string/s_d69060c"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    style="@style/Widget.Bisnor.Switch"
                    android:id="@+id/switch_content_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Other -->
        <TextView
            style="@style/TextAppearance.Bisnor.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/s_b47a8a7"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_setting_check_update"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/appFontMedium"
                        android:text="@string/s_d5f8583"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="?attr/appFontRegular"
                        android:id="@+id/tv_setting_version"
                        android:text=""
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <View style="@style/Widget.Bisnor.Divider" />

            <LinearLayout
                android:id="@+id/btn_setting_clear_cache"
                style="@style/Widget.Bisnor.SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/appFontMedium"
                        android:text="@string/s_fdcd08f"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="?attr/appFontRegular"
                        android:text="@string/s_72ecd11"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="?attr/appFontRegular"
            android:gravity="center"
            android:text="@string/s_ce0639b"
            android:textColor="@color/outline"
            android:textSize="10.5sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
