<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <!-- App / Player Icon -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="@color/surface_container_high"
        app:cardCornerRadius="14dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/img_player_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            app:tint="@color/primary" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_bold"
            android:text="پلیر بیسنور"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_player_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/vazirmatn_regular"
            android:text="آماده استفاده"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Selected Indicator or Download Button -->
    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/radio_player_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_player_install"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="نصب ⬇"
        android:textSize="11sp"
        android:visibility="gone"
        app:cornerRadius="10dp" />

</LinearLayout>
