<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ================= Immersive artwork (Apple TV style) ================= -->
    <FrameLayout
        android:id="@+id/header_artwork"
        android:layout_width="match_parent"
        android:layout_height="480dp">

        <ImageView
            android:id="@+id/img_header_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_shade" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_fade" />

        <!-- Kept for binding/sharing; Apple-style header shows the artwork only. -->
        <ImageView
            android:id="@+id/img_header_poster"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="?attr/appFontBold"
                android:gravity="center"
                android:maxLines="3"
                android:shadowColor="#99000000"
                android:shadowDy="2"
                android:shadowRadius="14"
                android:textColor="@color/white"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tv_header_original_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="?attr/appFontRegular"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_header_genres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="?attr/appFontMedium"
                android:gravity="center"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_header_type"
                    style="@style/TextAppearance.Bisnor.MetaChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tv_header_year"
                    style="@style/TextAppearance.Bisnor.MetaChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/tv_header_rating"
                    style="@style/TextAppearance.Bisnor.MetaChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@drawable/ic_star"
                    android:drawablePadding="3dp"
                    android:drawableTint="@color/rating_gold" />

                <TextView
                    android:id="@+id/tv_header_age_rating"
                    style="@style/TextAppearance.Bisnor.MetaChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ================= Primary actions ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_header_play"
            style="@style/Widget.Bisnor.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/btn_watch_now"
            app:icon="@drawable/ic_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_header_add_playlist"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_liquid_glass_button"
            app:backgroundTint="@null"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_bookmark"
            app:iconTint="@color/on_surface"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_header_share_chat"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_liquid_glass_button"
            app:backgroundTint="@null"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_share"
            app:iconTint="@color/on_surface"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_header_trailer"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_liquid_glass_button"
            app:backgroundTint="@null"
            android:visibility="gone"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_videoplayer"
            app:iconTint="@color/on_surface"
            app:strokeWidth="0dp" />
    </LinearLayout>

    <!-- ================= API metadata badges ================= -->
    <HorizontalScrollView
        android:id="@+id/scroll_header_badges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="18dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/linear_header_badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- ================= Synopsis ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_surface"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/appFontBold"
            android:text="@string/label_storyline"
            android:textColor="@color/on_surface"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tv_header_storyline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="?attr/appFontRegular"
            android:lineSpacingExtra="4dp"
            android:maxLines="4"
            android:textColor="@color/on_surface_variant"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btn_expand_story"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="?attr/appFontMedium"
            android:paddingVertical="4dp"
            android:text="@string/s_972f0d5"
            android:textColor="@color/primary"
            android:textSize="11.5sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ================= Cast & crew ================= -->
    <LinearLayout
        android:id="@+id/layout_header_people"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:fontFamily="?attr/appFontBold"
            android:text="@string/s_5e14edb"
            android:textColor="@color/on_surface"
            android:textSize="15.5sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_header_people"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- ================= Seasons & episodes ================= -->
    <TextView
        android:id="@+id/tv_header_section_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="22dp"
        android:fontFamily="?attr/appFontBold"
        android:text="@string/label_select_quality"
        android:textColor="@color/on_surface"
        android:textSize="15.5sp" />

    <HorizontalScrollView
        android:id="@+id/scroll_seasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingHorizontal="18dp"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_seasons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true" />
    </HorizontalScrollView>
</LinearLayout>
