<?xml version="1.0" encoding="utf-8"?>
<!-- Static liquid glass (for MaterialButtons): translucent body, hairline rim, top sheen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_tint" />
            <stroke android:width="1dp" android:color="@color/lg_rim_bottom" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:bottom="26dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="@color/lg_sheen" />
            <corners android:topLeftRadius="25dp" android:topRightRadius="25dp" />
        </shape>
    </item>
</layer-list>
