<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="beforeDescendants"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="112dp">

            <!-- ================= Hero (edge-to-edge, Apple TV style) ================= -->
            <FrameLayout
                android:id="@+id/hero_frame"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_banner_height"
                android:background="@color/surface_container">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/view_pager_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/layout_hero_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="6dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <!-- Floating glass header over the artwork -->
                <LinearLayout
                    android:id="@+id/home_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp">

                    <com.hnn.bisnor.ui.widget.GlassView
                        android:id="@+id/btn_home_avatar"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:clickable="true"
                        android:contentDescription="پروفایل"
                        android:focusable="true"
                        app:glassCornerRadius="23dp">

                        <TextView
                            android:id="@+id/tv_home_avatar_initial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/vazirmatn_bold"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/img_home_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_account_circle" />
                    </com.hnn.bisnor.ui.widget.GlassView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_home_greeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/vazirmatn_bold"
                            android:maxLines="1"
                            android:shadowColor="#80000000"
                            android:shadowRadius="10"
                            android:text="سلام"
                            android:textColor="@color/white"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tv_home_greeting_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn_regular"
                            android:shadowColor="#80000000"
                            android:shadowRadius="10"
                            android:text="امشب چه چیزی ببینیم؟"
                            android:textColor="#D9FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.hnn.bisnor.ui.widget.GlassView
                        android:id="@+id/btn_home_search"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:clickable="true"
                        android:contentDescription="جستجو"
                        android:focusable="true"
                        app:glassCornerRadius="23dp">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_search"
                            app:tint="@color/white" />
                    </com.hnn.bisnor.ui.widget.GlassView>
                </LinearLayout>
            </FrameLayout>

            <!-- ================= Loading skeleton ================= -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/skeleton_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp">

                    <View
                        android:layout_width="150dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_skeleton" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="132dp"
                            android:layout_height="196dp"
                            android:background="@drawable/bg_skeleton" />

                        <View
                            android:layout_width="132dp"
                            android:layout_height="196dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_skeleton" />

                        <View
                            android:layout_width="132dp"
                            android:layout_height="196dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_skeleton" />
                    </LinearLayout>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- ================= Content ================= -->
            <LinearLayout
                android:id="@+id/home_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Continue watching -->
                <LinearLayout
                    android:id="@+id/layout_continue_watching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/vazirmatn_bold"
                            android:text="در حال تماشا"
                            android:textColor="@color/on_surface"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/btn_continue_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/vazirmatn_medium"
                            android:padding="6dp"
                            android:text="کتابخانه"
                            android:textColor="@color/primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_continue_watching"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="4dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

                <!-- Content rows -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:gravity="center"
                    android:text="بیسنور • تماشا بدون مرز"
                    android:textColor="@color/outline"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ================= Empty / error state ================= -->
            <LinearLayout
                android:id="@+id/layout_home_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:alpha="0.6"
                    android:src="@drawable/ic_movie_placeholder"
                    app:tint="@color/outline" />

                <TextView
                    android:id="@+id/tv_home_error_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:gravity="center"
                    android:text="ارتباط با سرور برقرار نشد"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_home_error_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="اتصال اینترنت را بررسی کنید و دوباره تلاش کنید."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_home_retry"
                    style="@style/Widget.Bisnor.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:text="تلاش دوباره" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
