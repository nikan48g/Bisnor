<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container" />
            <stroke android:width="2.5dp" android:color="@color/primary" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container_high" />
            <stroke android:width="3dp" android:color="@color/on_surface" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container" />
            <stroke android:width="1dp" android:color="@color/outline_variant" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
