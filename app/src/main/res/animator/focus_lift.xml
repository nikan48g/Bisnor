<?xml version="1.0" encoding="utf-8"?>
<!-- TV / D-pad: the focused card lifts slightly, like tvOS. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="160" android:propertyName="scaleX" android:valueTo="1.07" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="scaleY" android:valueTo="1.07" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="translationZ" android:valueTo="12dp" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="160" android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="translationZ" android:valueTo="0dp" android:valueType="floatType" />
        </set>
    </item>
</selector>
