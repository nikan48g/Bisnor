<?xml version="1.0" encoding="utf-8"?>
<!-- Card outline: visible only while the card (via its parent) has D-pad focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/on_surface" />
    <item android:color="@android:color/transparent" />
</selector>
